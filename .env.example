# mcp-n4j-memory — environment template. Copy to .env and fill in.
# Real secrets must NEVER be committed. See docs/SPECIFICATION.md §7.

# --- Neo4j (consumed by: neo4j, mcp) ---
NEO4J_PASSWORD=change-me            # DB auth (required)
NEO4J_URI=bolt://neo4j:7687        # bolt endpoint on db-net
NEO4J_USER=neo4j
NEO4J_DATABASE=neo4j

# --- Framework LLM wiring (consumed by: mcp) ---
NAM_LLM__PROVIDER=openai          # OpenAI-compatible -> routed to LiteLLM proxy
# Local/llm-smoke default routes to the LiteLLM mock-backed model (no Anthropic
# credential needed). Production deployments override to NAM_LLM__MODEL=claude
# with a real ANTHROPIC_API_KEY supplied only to llm-proxy.
NAM_LLM__MODEL=claude-mock
NAM_LLM__API_KEY=change-me         # LiteLLM virtual key (== LITELLM_MASTER_KEY)
OPENAI_BASE_URL=http://llm-proxy:4000/v1
NAM_EMBEDDING__PROVIDER=sentence_transformers
NAM_EMBEDDING__MODEL=BAAI/bge-small-en-v1.5   # local, offline embedder
NAM_EMBEDDING__DIMENSIONS=384
# Offline guarantees (satisfies R3/AC-C7/AC-G5): the baked model must load
# from local cache only, never attempting a Hugging Face network download.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# --- MCP transport (consumed by: mcp) ---
MCP_TRANSPORT=http
MCP_HOST=0.0.0.0
MCP_PORT=8080

# --- LiteLLM proxy (consumed by: llm-proxy) ---
LITELLM_MASTER_KEY=change-me       # virtual key the proxy accepts from mcp

# --- Anthropic credential: llm-proxy ONLY (C5/C6) ---
# Do NOT expose this to the mcp or neo4j services.
ANTHROPIC_API_KEY=change-me        # real Anthropic API key
